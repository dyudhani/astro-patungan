---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="shell">
    <header class="brand">
      <span class="brand-mark">patungan.</span>
      <span class="brand-tag" id="brand-tag">split bill · 100% offline</span>
    </header>

    <section class="hero">
      <h1 id="hero-title">Bagi bill, <em style="color: var(--accent);">tanpa drama.</em></h1>
      <p id="hero-desc">
        Upload foto struk, pilih siapa pesan apa, kelar. OCR jalan di browser
        kamu — tidak ada data yang dikirim ke server.
      </p>
    </section>

    <div class="stepper" id="stepper" role="list" aria-label="Progress">
      <div class="stepper-item is-active" id="stepper-item-1" data-step="1" role="listitem">
        <span class="stepper-dot" data-num="1">1</span>
        <span class="stepper-label" id="stepper-label-1">Upload</span>
      </div>
      <div class="stepper-line" id="stepper-line-1"></div>
      <div class="stepper-item" id="stepper-item-2" data-step="2" role="listitem">
        <span class="stepper-dot" data-num="2">2</span>
        <span class="stepper-label" id="stepper-label-2">Cek Struk</span>
      </div>
      <div class="stepper-line" id="stepper-line-2"></div>
      <div class="stepper-item" id="stepper-item-3" data-step="3" role="listitem">
        <span class="stepper-dot" data-num="3">3</span>
        <span class="stepper-label" id="stepper-label-3">Bagi</span>
      </div>
    </div>

    <section class="card" id="step-upload">
      <div class="step">
        <span class="step-num">1</span>
        <span class="step-title" id="step1-title">Foto struk</span>
      </div>

      <label class="dropzone" id="dropzone">
        <svg
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 7.5m0 0L7.5 12M12 7.5v9"
          ></path>
        </svg>
        <div class="dropzone-text" id="dropzone-text">Tap untuk pilih foto struk</div>
        <div class="dropzone-hint" id="dropzone-hint">atau drag &amp; drop · JPG, PNG, WEBP</div>
        <input
          type="file"
          id="file-input"
          accept="image/jpeg,image/png,image/webp"
        />
      </label>

      <div class="preview hidden" id="preview">
        <img id="preview-img" alt="Preview struk" />
        <button
          class="preview-remove"
          id="preview-remove"
          type="button"
          aria-label="Hapus">✕</button
        >
      </div>

      <div id="append-mode-banner"></div>

      <div id="upload-error"></div>

      <!-- Progress -->
      <div class="hidden" id="progress-wrap">
        <div class="progress">
          <div class="progress-bar" id="progress-bar" style="width: 0%"></div>
        </div>
        <div class="progress-text" id="progress-text">Memuat OCR...</div>
      </div>

      <button
        class="btn btn-primary btn-block"
        id="btn-scan"
        disabled
        style="margin-top: 16px;"
      >
        <span id="scan-label">Pilih foto dulu</span>
      </button>

      <button
        class="btn btn-secondary btn-block"
        id="btn-skip"
        style="margin-top: 8px; font-size: 13px;"
      >
        Lewati scan — input manual
      </button>
    </section>

    <section class="card hidden" id="step-bill">
      <div class="step">
        <span class="step-num">2</span>
        <span class="step-title" id="step2-title">Cek isi struk</span>
      </div>
      <p class="card-subtitle" id="step2-subtitle">
        Penting: Sesuaikan Harga Total & Satuan jika ada yang salah baca.
      </p>

      <div id="scan-warning"></div>

      <div id="items-list"></div>
      <datalist id="item-name-suggestions"></datalist>

      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top: 12px;">
        <button
          class="btn btn-secondary"
          id="btn-add-item"
          style="font-size: 14px; padding: 8px 14px;"
          >+ Tambah pesanan</button
        >
        <button
          class="btn btn-secondary"
          id="btn-add-receipt"
          style="font-size: 14px; padding: 8px 14px;"
          >📷 Tambah dari struk lain</button
        >
      </div>

      <div class="totals">
        <div class="totals-row">
          <span id="subtotal-label">Subtotal</span>
          <span class="mono" id="t-subtotal">Rp 0</span>
        </div>

        <div class="totals-row">
          <span id="tax-label">Pajak (Tax)</span>
          <div style="display:flex; gap:6px; align-items:center;">
            <select
              id="t-tax-mode"
              class="input"
              aria-label="Mode pajak: Rupiah atau persen"
              style="padding: 6px; width: 65px; text-align: center; cursor: pointer; color: var(--ink);"
            >
              <option value="nominal">Rp</option>
              <option value="percent">%</option>
            </select>
            <input
              type="number"
              class="input mono"
              id="t-tax"
              aria-label="Pajak (Tax)"
              style="max-width: 120px; text-align: right; padding: 6px 10px;"
            />
          </div>
        </div>
        <div
          class="totals-row hidden"
          id="t-tax-nominal-row"
          style="padding:0; margin-top:-4px; justify-content:flex-end;"
        >
          <span
            class="mono"
            id="t-tax-nominal-display"
            style="font-size:13px; color:var(--ink-muted); font-weight:600;"
          ></span>
        </div>
        <div class="totals-row">
          <span id="service-label">Service Charge</span>
          <div style="display:flex; gap:6px; align-items:center;">
            <select
              id="t-service-mode"
              class="input"
              aria-label="Mode service charge: Rupiah atau persen"
              style="padding: 6px; width: 65px; text-align: center; cursor: pointer; color: var(--ink);"
            >
              <option value="nominal">Rp</option>
              <option value="percent">%</option>
            </select>
            <input
              type="number"
              class="input mono"
              id="t-service"
              aria-label="Service Charge"
              style="max-width: 120px; text-align: right; padding: 6px 10px;"
            />
          </div>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:6px; padding: 2px 0 6px;">
          <button type="button" class="btn btn-secondary" data-service-preset="10" style="font-size:12px; padding:4px 10px;">10%</button>
          <button type="button" class="btn btn-secondary" data-service-preset="15" style="font-size:12px; padding:4px 10px;">15%</button>
          <button type="button" class="btn btn-secondary" data-service-preset="20" style="font-size:12px; padding:4px 10px;">20%</button>
        </div>
        <div
          class="totals-row hidden"
          id="t-service-nominal-row"
          style="padding:0; margin-top:-4px; justify-content:flex-end;"
        >
          <span
            class="mono"
            id="t-service-nominal-display"
            style="font-size:13px; color:var(--ink-muted); font-weight:600;"
          ></span>
        </div>
        <div class="totals-row">
          <span id="discount-label">Diskon</span>
          <div style="display:flex; gap:6px; align-items:center;">
            <select
              id="t-discount-mode"
              class="input"
              aria-label="Mode diskon: Rupiah atau persen"
              style="padding: 6px; width: 65px; text-align: center; cursor: pointer; color: var(--ink);"
            >
              <option value="nominal">Rp</option>
              <option value="percent">%</option>
            </select>
            <input
              type="number"
              class="input mono"
              id="t-discount"
              aria-label="Diskon"
              style="max-width: 120px; text-align: right; padding: 6px 10px;"
            />
          </div>
        </div>
        <div
          class="totals-row hidden"
          id="t-discount-nominal-row"
          style="padding:0; margin-top:-4px; justify-content:flex-end;"
        >
          <span
            class="mono"
            id="t-discount-nominal-display"
            style="font-size:13px; color:var(--ink-muted); font-weight:600;"
          ></span>
        </div>
        <div class="totals-row grand">
          <span id="total-bill-label">Total Bill</span>
          <span class="mono" id="t-total">Rp 0</span>
        </div>
      </div>

      <button
        class="btn btn-primary btn-block"
        id="btn-to-people"
        style="margin-top: 18px;">Lanjut ke pembagian →</button
      >
    </section>

    <section class="card hidden" id="step-people">
      <div class="step">
        <span class="step-num">3</span>
        <span class="step-title" id="step3-title">Bagi per Pesanan</span>
      </div>
      <p class="card-subtitle" id="step3-subtitle">
        Tambah nama teman yang ikut patungan, lalu tandai siapa saja yang makan
        di tiap pesanan.
      </p>

      <div class="add-person-row" style="margin-bottom: 20px;">
        <input
          type="text"
          class="input"
          id="new-person"
          placeholder="Ketik nama (cth. Andi)"
          aria-label="Nama teman baru"
        />
        <button
          class="btn btn-secondary"
          id="btn-add-person"
          style="background:#0F172A; color:#FFFFFF; border:none;"
          >+ Teman</button
        >
      </div>

      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
        <button
          type="button"
          class="btn btn-secondary"
          id="btn-save-group"
          style="font-size:13px; padding:8px 14px;"
          >💾 Simpan grup ini</button
        >
        <button
          type="button"
          class="btn btn-secondary"
          id="btn-load-group"
          style="font-size:13px; padding:8px 14px;"
          >👥 Pakai grup tersimpan</button
        >
      </div>

      <div
        class="hidden"
        id="save-group-panel"
        style="display:flex; gap:8px; margin-bottom:16px;"
      >
        <input
          type="text"
          class="input"
          id="group-name-input"
          placeholder="Nama grup (mis: Kantor Squad)"
          aria-label="Nama grup"
          style="flex:1;"
        />
        <button
          type="button"
          class="btn btn-primary"
          id="btn-confirm-save-group"
          style="flex-shrink:0;">Simpan</button
        >
      </div>

      <div class="hidden" id="load-group-panel" style="margin-bottom:16px;"></div>

      <div id="people-list"></div>

      <button
        class="btn btn-primary btn-block"
        id="btn-calculate"
        style="margin-top: 20px;">Hitung & Tampilkan Hasil ↓</button
      >
    </section>

    <section class="summary hidden" id="step-result">
      <h2 id="result-heading">Hasil <em style="color: var(--accent);">Patungan</em></h2>
      <div class="summary-sub" id="summary-sub">—</div>

      <div id="summary-list"></div>

      <div class="btn-row" style="margin-top: 24px;">
        <button
          class="btn btn-block"
          id="btn-download"
          style="background: var(--accent); color: var(--bg); font-weight: bold; font-size: 16px; padding: 14px;"
        >
          <span id="btn-download-label">📥 Download / Cetak PDF</span>
        </button>
      </div>

      <div class="btn-row">
        <button
          class="btn btn-block"
          id="btn-reset"
          style="background: transparent; color: var(--bg); border: 1px solid rgba(248,250,252,0.2);"
          >Mulai ulang</button
        >
      </div>
    </section>

    <footer>
      <p id="footer-text">
        © dyudhani 2026 | Gratis · tanpa daftar · tanpa server ·
        OCR jalan di browser kamu
      </p>
    </footer>
  </main>

  <script>
    import "../lib/app";
  </script>
</Layout>
