---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="shell">
    <header class="brand">
      <span class="brand-mark">patungan.</span>
      <span class="brand-tag">split bill · 100% offline</span>
    </header>

    <section class="hero">
      <h1>Bagi bill, <em>tanpa drama.</em></h1>
      <p>
        Upload foto struk, pilih siapa pesan apa, kelar. OCR jalan di browser
        kamu — tidak ada data yang dikirim ke server.
      </p>
    </section>

    <!-- STEP 1: Upload -->
    <section class="card" id="step-upload">
      <div class="step">
        <span class="step-num">1</span>
        <span class="step-title">Foto struk</span>
      </div>

      <label class="dropzone" id="dropzone">
        <svg
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 7.5m0 0L7.5 12M12 7.5v9"
          ></path>
        </svg>
        <div class="dropzone-text">Tap untuk pilih foto struk</div>
        <div class="dropzone-hint">atau drag &amp; drop · JPG, PNG, WEBP</div>
        <input
          type="file"
          id="file-input"
          accept="image/jpeg,image/png,image/webp"
        />
      </label>

      <div class="preview hidden" id="preview">
        <img id="preview-img" alt="Preview struk" />
        <button
          class="preview-remove"
          id="preview-remove"
          type="button"
          aria-label="Hapus">✕</button
        >
      </div>

      <div id="upload-error"></div>

      <div class="hidden" id="progress-wrap">
        <div class="progress">
          <div class="progress-bar" id="progress-bar" style="width: 0%"></div>
        </div>
        <div class="progress-text" id="progress-text">Memuat OCR...</div>
      </div>

      <button
        class="btn btn-primary btn-block"
        id="btn-scan"
        disabled
        style="margin-top: 16px;"
      >
        <span id="scan-label">Pilih foto dulu</span>
      </button>

      <button
        class="btn btn-secondary btn-block"
        id="btn-skip"
        style="margin-top: 8px; font-size: 13px;"
      >
        Lewati scan — input manual
      </button>
    </section>

    <!-- STEP 2: Bill items -->
    <section class="card hidden" id="step-bill">
      <div class="step">
        <span class="step-num">2</span>
        <span class="step-title">Cek isi struk</span>
      </div>
      <p class="card-subtitle">
        OCR offline kadang nggak sempurna. Cek & edit kalau ada yang salah.
      </p>

      <div id="items-list"></div>

      <button
        class="btn btn-secondary"
        id="btn-add-item"
        style="margin-top: 12px; font-size: 14px; padding: 8px 14px;"
        >+ Tambah item</button
      >

      <div class="totals">
        <div class="totals-row">
          <span>Subtotal</span>
          <span class="mono" id="t-subtotal">Rp 0</span>
        </div>
        <div class="totals-row">
          <span>Pajak (Tax)</span>
          <input
            type="number"
            class="input mono"
            id="t-tax"
            style="max-width: 140px; text-align: right; padding: 6px 10px;"
          />
        </div>
        <div class="totals-row">
          <span>Service Charge</span>
          <input
            type="number"
            class="input mono"
            id="t-service"
            style="max-width: 140px; text-align: right; padding: 6px 10px;"
          />
        </div>
        <div class="totals-row">
          <span>Diskon</span>
          <input
            type="number"
            class="input mono"
            id="t-discount"
            style="max-width: 140px; text-align: right; padding: 6px 10px;"
          />
        </div>
        <div class="totals-row grand">
          <span>Total Bill</span>
          <span class="mono" id="t-total">Rp 0</span>
        </div>
      </div>

      <button
        class="btn btn-primary btn-block"
        id="btn-to-people"
        style="margin-top: 18px;">Lanjut ke pembagian →</button
      >
    </section>

    <!-- STEP 3: People -->
    <section class="card hidden" id="step-people">
      <div class="step">
        <span class="step-num">3</span>
        <span class="step-title">Siapa pesan apa?</span>
      </div>
      <p class="card-subtitle">
        Tambah nama orang, centang makanannya. Item yang dipilih beberapa orang
        dibagi rata.
      </p>

      <div id="people-list"></div>

      <div class="add-person-row">
        <input
          type="text"
          class="input"
          id="new-person"
          placeholder="Nama (cth. Andi)"
        />
        <button class="btn btn-secondary" id="btn-add-person">+ Tambah</button>
      </div>

      <button
        class="btn btn-primary btn-block"
        id="btn-calculate"
        style="margin-top: 20px;">Hitung & Tampilkan Hasil ↓</button
      >
    </section>

    <!-- STEP 4: Result -->
    <section class="summary hidden" id="step-result">
      <h2>Hasil <em>Patungan</em></h2>
      <div class="summary-sub" id="summary-sub">—</div>
      <div id="summary-list"></div>

      <div class="btn-row">
        <button
          class="btn btn-primary btn-block"
          id="btn-download"
          style="background: var(--accent);"
        >
          <span>📥 Download Gambar</span>
        </button>
      </div>
      <div class="btn-row">
        <button
          class="btn btn-secondary btn-block"
          id="btn-reset"
          style="background: transparent; color: var(--bg); border-color: rgba(248,250,252,0.2);"
          >Mulai ulang</button
        >
      </div>
    </section>

    <div class="render-target hidden" id="render-target"></div>

    <footer>
      <p>
        <span>&copy; dyudhani 2026 |</span> Gratis · tanpa daftar · tanpa server ·
        OCR jalan di browser kamu
      </p>
    </footer>
  </main>

  <script>
    import "../lib/app";
  </script>
</Layout>
